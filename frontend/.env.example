NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api
NEXT_PUBLIC_BACKEND_STORAGE_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_AI_STREAM_WS_URL=ws://127.0.0.1:8001
NEXT_PUBLIC_FACE_WS_URL=ws://127.0.0.1:8001/ws_face
NEXT_PUBLIC_AI_WEBCAM_FPS=3
# Sign in with Google for administrators. Same OAuth client ID as the
# backend's GOOGLE_CLIENT_ID; the button is hidden while this is empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

AUTH_BYPASS=false

# Server-only authentication values. Never prefix these with NEXT_PUBLIC_.
JWT_SECRET_KEY=replace-with-the-same-long-secret-as-backend
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
