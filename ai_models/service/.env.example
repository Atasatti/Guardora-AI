GUARDORA_AI_HOST=127.0.0.1
GUARDORA_AI_PORT=8001
GUARDORA_STREAM_FPS=3
GUARDORA_VIDEO_DIR=../../frontend/public/videos
GUARDORA_FACE_GALLERY=../face_gallery
GUARDORA_FACE_COSINE_THRESHOLD=0.363
GUARDORA_BACKEND_API_URL=http://127.0.0.1:4000/api
GUARDORA_AI_SERVICE_API_KEY=replace-with-the-same-key-as-backend

# Both default to true so every model runs. Set both to false for a commercial
# deployment; see ../MODEL_LICENSES.md.
# YOLO weapon and fire models: AGPL-3.0 Ultralytics, not for commercial use
# without an Ultralytics enterprise license.
GUARDORA_ALLOW_AGPL_MODELS=true

# X3D violence checkpoint: research/non-commercial terms.
GUARDORA_ALLOW_RESEARCH_MODELS=true
